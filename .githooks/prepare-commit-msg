#!/bin/sh
# Strip Cursor attribution trailers (IDE adds them when Agent > Attribution is on).
case "$(uname -s)" in
Darwin) sed -i '' '/^Co-authored-by: Cursor <cursoragent@cursor.com>$/d' "$1" ;;
*) sed -i '/^Co-authored-by: Cursor <cursoragent@cursor.com>$/d' "$1" ;;
esac
case "$(uname -s)" in
Darwin) sed -i '' '/^Made-with: Cursor$/d' "$1" ;;
*) sed -i '/^Made-with: Cursor$/d' "$1" ;;
esac
